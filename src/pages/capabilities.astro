---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Capabilities - OmniR3"
  description="Explore OmniR3 software development and platform engineering capabilities."
  currentPath="/capabilities"
>
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">Capabilities</p>
      <h1>
        From architecture to operations, we deliver across the full software
        lifecycle.
      </h1>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container cards two">
      <article class="card">
        <h3>Custom Software Engineering</h3>
        <p>
          Enterprise applications, APIs, and modular service architecture
          tailored to your operational needs.
        </p>
      </article>
      <article class="card">
        <h3>Cloud Platform Delivery</h3>
        <p>
          Secure cloud-native environments, infrastructure as code, and
          automated release pipelines — including private-by-default access for
          internal and preview deployments.
        </p>
      </article>
      <article class="card">
        <h3>Systems Integration</h3>
        <p>
          Reliable connections across legacy systems, third-party services, and
          business-critical data pipelines.
        </p>
      </article>
      <article class="card">
        <h3>Quality Engineering</h3>
        <p>
          Comprehensive test strategy, performance validation, and release
          confidence at scale.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Technology Domains</h2>
      <div class="cards four compact">
        <article class="card">
          <h3>Frontend</h3><p>Astro, React, TypeScript, Design Systems</p>
        </article>
        <article class="card">
          <h3>Backend</h3><p>Node.js, .NET, Python, API Platforms</p>
        </article>
        <article class="card">
          <h3>Cloud</h3><p>Azure, AWS, Cloudflare, Kubernetes, CI/CD</p>
        </article>
        <article class="card">
          <h3>Data</h3><p>PostgreSQL, SQL Server, Redis, Event Streams</p>
        </article>
      </div>
    </div>
  </section>
</MainLayout>
