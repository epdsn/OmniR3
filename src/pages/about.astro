---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="About - OmniR3"
  description="Learn about OmniR3's mission, values, and delivery approach."
  currentPath="/about"
>
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">About OmniR3</p>
      <h1>
        We engineer dependable software that keeps business operations in
        motion.
      </h1>
      <p class="lead">
        Our mission is simple: build critical systems that are resilient,
        accountable, and repeatable across every stage of growth.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container cards two">
      <article class="card">
        <h3>Quality First</h3>
        <p>
          We apply disciplined engineering standards, from architecture reviews
          through production readiness.
        </p>
      </article>
      <article class="card">
        <h3>Client Success</h3>
        <p>
          Delivery is measured by tangible business impact, not feature volume.
        </p>
      </article>
      <article class="card">
        <h3>Technical Excellence</h3>
        <p>
          Modern technologies paired with proven implementation strategies that
          minimize risk.
        </p>
      </article>
      <article class="card">
        <h3>Ethical Practice</h3>
        <p>
          Transparent communication, clear ownership, and responsible decision
          making.
        </p>
      </article>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Need a delivery partner who can own the hard parts?</h2>
      <a class="btn btn-primary" href="/contact">Get in Touch</a>
    </div>
  </section>
</MainLayout>
